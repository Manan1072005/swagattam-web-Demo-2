# Vite exposes only variables prefixed with VITE_ to browser code.
# Use the Supabase project URL and the public anon key. Never use a service-role key.
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# GitHub Pages project sites normally use /repository-name/.
# Use / for a custom domain or a repository configured at the domain root.
VITE_BASE_PATH=/